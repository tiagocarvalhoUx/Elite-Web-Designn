# Endpoint opcional que recebe o formulário de contato (POST JSON).
# Sem ele, a solicitação é entregue pelo cliente de e-mail do visitante.
# VITE_CONTACT_ENDPOINT=https://api.exemplo.com/contato

# Supabase — copie para .env.local e preencha com as chaves do seu projeto.
# Somente chaves públicas: a URL e a publishable key (sb_publishable_...).
# A secret key (sb_secret_...) nunca deve aparecer no frontend.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Meta Pixel — Gerenciador de Eventos do Facebook Ads.
# Sem esta variável, nenhum script do Meta é carregado e nenhuma requisição
# sai para o Facebook: o site funciona normalmente.
# VITE_META_PIXEL_ID=1234567890123456

# ---------------------------------------------------------------------------
# Aviso de novo lead por e-mail (função de servidor em api/notify-lead.ts).
#
# Estas NÃO levam prefixo VITE_ de propósito: qualquer variável VITE_ é
# compilada dentro do bundle público. Estas são lidas só no servidor da Vercel
# e devem ser cadastradas em Settings -> Environment Variables.
#
# RESEND_API_KEY=re_xxxxxxxxxxxx
# LEAD_NOTIFY_TO=seu-email@exemplo.com
# LEAD_NOTIFY_FROM=Elite Web Designer <onboarding@resend.dev>
