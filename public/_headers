# Cabeçalhos de resposta no Cloudflare Pages — porte do bloco "headers" do
# vercel.json. Fontes e bundles levam hash no nome, então podem ser guardados
# para sempre; o resto recebe apenas as proteções básicas.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
